# Copy this file to .env and fill in local credentials.
# Never commit .env. Keep all secrets on the backend only.

# Crustdata — required for live intelligence retrieval
CRUSTDATA_API_KEY=

# Anthropic — optional runtime LLM. The application must work without this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Official docs (checked 31 Oct 2026) document anthropic-version: 2023-06-01.
ANTHROPIC_API_VERSION=2023-06-01
LLM_ENABLED=true
LLM_SPEND_CAP_USD=5
LLM_MAX_CALLS_PER_REQUEST=3
LLM_MAX_OUTPUT_TOKENS=1200

# Application configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./contextcon03.db
LOG_LEVEL=INFO

# Crustdata run-level guardrail. Confirm/adjust against the existing project config.
CRUSTDATA_RUN_CREDIT_CAP=150
# Estimated Anthropic pricing (USD per million tokens) — verify against official pricing.
ANTHROPIC_PRICE_INPUT_PER_MTOK=2
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=10

# Watcher. Leave PUBLIC_WEBHOOK_URL empty to create a pull-only watch (notifications: []).
WATCH_AUTO_CREATE=true
PUBLIC_WEBHOOK_URL=
WATCH_EVERY_HOURS=168
WATCH_MAX_RESULTS_PER_RUN=25
WATCH_MAX_ENTITIES=10
