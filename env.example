# Copy this file to .env and fill in local credentials.
# Never commit .env. Keep all secrets on the backend only.

# Crustdata — required for live intelligence retrieval
CRUSTDATA_API_KEY=

# Anthropic — optional runtime LLM. The application must work without this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_VERSION=2026-10-21
LLM_ENABLED=true
LLM_SPEND_CAP_USD=5
LLM_MAX_CALLS_PER_REQUEST=3
LLM_MAX_OUTPUT_TOKENS=1200

# Application configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./contextcon03.db
LOG_LEVEL=INFO

# Crustdata run-level guardrail. Confirm/adjust against the existing project config.
CRUSTDATA_RUN_CREDIT_CAP=150
